# ============================================================
# NUTRIPROGRESS API - Environment Variables
# Copy to .env and fill in values
# NEVER commit .env to git
# ============================================================

# Spring
SPRING_PROFILES_ACTIVE=dev
PORT=8080

# Database — PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/nutriprogress_dev
DB_USERNAME=nutriprogress
DB_PASSWORD=nutriprogress123

# Database — PostgreSQL (prod Render format)
DATABASE_URL=jdbc:postgresql://host:5432/nutriprogress

# Database — MongoDB
MONGODB_URI=mongodb://nutriprogress:nutriprogress123@localhost:27017/nutriprogress_analytics?authSource=admin

# Message Broker — RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=nutriprogress
RABBITMQ_PASS=nutriprogress123
RABBITMQ_VHOST=nutriprogress

# Cache — Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=nutriprogress123

# Auth — JWT
JWT_SECRET=your-super-secret-key-minimum-512-bits-change-in-production
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# Auth — Google OAuth
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret

# Payments — Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_PREMIUM=price_...

# Email — SMTP
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=noreply@nutriprogress.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=noreply@nutriprogress.com

# App
APP_URL=http://localhost:3000
